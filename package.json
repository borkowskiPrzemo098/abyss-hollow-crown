{
  "name": "abyss-hollow-crown",
  "version": "0.1.0",
  "private": true,
  "description": "ABYSS: The Hollow Crown — dark fantasy isometric action roguelite (mobile PWA)",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host --port 4930",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "@fontsource/alegreya-sans": "^5.3.0",
    "@fontsource/grenze-gotisch": "^5.3.0",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "typescript": "~6.0.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
